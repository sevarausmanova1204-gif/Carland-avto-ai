# Telegram bot tokenini @BotFather dan oling
TELEGRAM_BOT_TOKEN=

# AI provider tanlovi: "anthropic" yoki "openai"
AI_PROVIDER=anthropic

# Anthropic (Claude) API kaliti — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OpenAI API kaliti — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
